# Copy to .env. Development values only.
# WARNING: this repository is public. Never commit real secrets; keep them only in your local .env.

# PostgreSQL container (docker-compose)
POSTGRES_DB=warbox
POSTGRES_USER=warbox
POSTGRES_PASSWORD=warbox
POSTGRES_PORT=5432

# Backend datasource (Spring reads these; defaults match docker-compose)
DB_URL=jdbc:postgresql://localhost:5432/warbox
DB_USERNAME=warbox
DB_PASSWORD=warbox
SERVER_PORT=8080

# Mailpit (local SMTP sink, UI at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
