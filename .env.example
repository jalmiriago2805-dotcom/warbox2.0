# Copy to .env (optional: every variable has a working default).
# Development values only. This repository is public: never put real secrets here.

# PostgreSQL (shared by docker-compose and the Spring backend)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warbox
POSTGRES_USER=warbox
POSTGRES_PASSWORD=warbox

# Backend HTTP port
SERVER_PORT=8080

# Mailpit (local SMTP sink and web UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Where the Vite dev server proxies /api
API_PROXY_TARGET=http://localhost:8080

# Outgoing e-mail (SMTP). Development points to Mailpit; no authentication.
MAIL_HOST=localhost
MAIL_PORT=1025
# Sender of account e-mails (verification, password reset)
MAIL_FROM=Warbox <no-reply@warbox.local>

# Public URL of the frontend, used to build the links sent by e-mail
APP_BASE_URL=http://localhost:5173

# Session cookie (JSESSIONID). Set SESSION_COOKIE_SECURE=true behind HTTPS.
SESSION_COOKIE_SECURE=false
# Session lifetime and cookie max-age (Spring Duration: 30m, 12h, 7d...)
SESSION_TIMEOUT=7d
